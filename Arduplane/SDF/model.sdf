<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Mini-talon dimensions

    wing
    chord root: 0.248 m
    chord tip:  0.211 m
    span:       0.570 m
    area:       0.131 m^2

    aileron
    chord root: 0.0533 m
    chord tip:  0.0533 m
    span:       0.229 m
    area:       0.0122 m^2

    v-tail
    chord root: 0.1385 m
    chord tip:  0.0864 m
    span:       0.2 m
    area:       0.0225 m^2
  
    ruddervator
    chord root: 0.0479 m
    chord tip:  0.0349 m
    span:       0.147 m
    area:       0.061 m^2


  -->
  <model name="talon_balloon_chaser">

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.024607948</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.086155637</iyy>
          <iyz>0</iyz>
          <izz>0.103828985</izz>
        </inertia>
      </inertial>

      <collision name="fuselage_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_fuselage_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="left_wing_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_left_wing_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="right_wing_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_right_wing_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="left_tail_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_left_tail_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <collision name="right_tail_collision">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_right_tail_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="fuselage_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_fuselage.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="fuselage_logos_visual">
        <pose degrees="true">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_fuselage_logos.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
                <albedo_map>model://talon_balloon_chaser/meshes/ardupilot_logo.png</albedo_map>
                <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="forward_deck_visual">
