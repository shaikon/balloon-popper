      <!-- Sensors. -->
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
      </sensor>
    </link>

    <link name="main_wheel_link">
      <pose degrees="true">0.302018 0 -0.097974 90 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1.01896E-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.01896E-06</iyy>
          <iyz>0</iyz>
          <izz>1.71125E-06</izz>
        </inertia>
      </inertial>
      <collision name="main_wheel_collision">
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_main_wheel_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="main_wheel_visual">
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_main_wheel.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01</diffuse>
          <specular>0.01 0.01 0.01</specular>
          <pbr>
            <metal>
                <metalness>0.1</metalness>
                <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name="main_wheel_joint" type="revolute">
      <pose degrees="true">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>main_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e-16</lower>
          <upper>1.0e+16</upper>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="left_aileron_link">
      <pose degrees="true">-0.107 0.371 0.0174 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>4.68283E-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.54167E-06</iyy>
          <iyz>0</iyz>
          <izz>4.93283E-05</izz>
        </inertia>
      </inertial>
      <collision name="left_aileron_collision">
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/mini_talon_left_aileron.dae</uri>
          </mesh>
        </geometry>
      </collision>
