            <uri>model://talon_balloon_chaser/meshes/mini_talon_right_wing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
