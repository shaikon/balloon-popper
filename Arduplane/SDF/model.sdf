    <link name="motor_link">
      <pose degrees="true">-0.41 0 -0.03 0 90 0</pose>
      <inertial>
        <!-- <mass>0.106</mass>
        <inertia>
          <ixx>1.95636E-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.95636E-05</iyy>
          <iyz>0</iyz>
          <izz>1.62313E-05</izz>
        </inertia> -->
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>

      <collision name="motor_collision">
        <pose degrees="true">0 0 0.018 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0175</radius>
            <length>0.036</length>
          </cylinder>
        </geometry>
      </collision>
      <collision name="propeller_collision">
        <pose degrees="true">0 0 -0.005 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="motor_visual">
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/propdrive_3536_motor_can.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="propeller_visual">
        <pose degrees="true">0 0 -0.005 0 180 0</pose>
        <geometry>
          <mesh>
            <uri>model://talon_balloon_chaser/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
      </visual>
    </link>
    <joint name="motor_joint" type="revolute">
      <pose degrees="true">0 0 0 0 180 0</pose>
      <parent>base_link</parent>
      <child>motor_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e-16</lower>
          <upper>1.0e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- System plugins. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- Positive is up. -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_aileron_joint</joint_name>
      <initial_position>0.0</initial_position>
      <topic>/left_aileron_joint/cmd_pos</topic>
      <p_gain>10</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <!-- Positive is up. -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_aileron_joint</joint_name>
      <initial_position>0.0</initial_position>
      <topic>/right_aileron_joint/cmd_pos</topic>
      <p_gain>10</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <!-- Positive is up. -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_ruddervator_joint</joint_name>
      <initial_position>0.0</initial_position>
      <topic>/left_ruddervator_joint/cmd_pos</topic>
      <p_gain>10</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <!-- Positive is up. -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_ruddervator_joint</joint_name>
      <initial_position>0.0</initial_position>
      <topic>/right_ruddervator_joint/cmd_pos</topic>
      <p_gain>10</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <!--
      Every lift-drag element below - the two propeller blades, the wings,
      the V-tail and the fuselage side force - is AltitudeLiftDrag
      (Arduplane/AltitudeLiftDrag in the Competition repo): stock LiftDrag
      with the air density of the 1976 standard atmosphere at the element's
      height, the air ArduPilot's airspeed reading assumes.  It takes the
      height from the world's <spherical_coordinates><elevation>, which must
      equal ArduPilot's home altitude, and it has no <air_density>.  The
      library must be built and installed (see its CMakeLists.txt) or none
      of these elements loads and the aircraft has no lift and no thrust.
    -->

    <!-- motor_joint cw -->
    <plugin filename="AltitudeLiftDrag"
        name="talon_sim::AltitudeLiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.25</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.02</area>
      <cp>0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_link</link_name>
    </plugin>
    <plugin filename="AltitudeLiftDrag"
        name="talon_sim::AltitudeLiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.25</cla>
      <cda>0.10</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.02</area>
      <cp>-0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>motor_link</link_name>
    </plugin>

    <!-- left wing -->
    <plugin filename="AltitudeLiftDrag"
        name="talon_sim::AltitudeLiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>0 0.27 0.029</cp>
      <area>0.16</area>
      <forward>1 0 0</forward>
      <!-- DIHEDRAL (L_beta).  Was <upward>0 0 1</upward>, a flat panel: with
           forward 1 0 0 and upward 0 0 1 the lift direction is ldNormal x vel,
           which has NO y-component for any velocity at all.  So sideslip made
           neither side force nor roll.  Measured: 9 deg of sideslip, ailerons
           at rest, 0.00 deg/s of roll rate.
           Canted 5.0 deg so the windward panel gains incidence and the
           aircraft rolls AWAY from the slip.  This is the term that makes a
           rudder-only turn work on a real aeroplane: the skid force alone is
           worth about 6 deg/s, the bank it induces is worth far more.
           5.0 deg is an ESTIMATE - the real dihedral is baked into the wing
           mesh and no <pose> in this file records it.  Measure it and change
           both wings' y-component. -->
      <upward>0 -0.0872 0.9962</upward>
      <link_name>base_link</link_name>
      <control_joint_name>left_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-0.75</control_joint_rad_to_cl>
    </plugin>

    <!-- right wing -->
    <plugin filename="AltitudeLiftDrag"
        name="talon_sim::AltitudeLiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>0 -0.27 0.029</cp>
      <area>0.16</area>
      <forward>1 0 0</forward>
      <upward>0 0.0872 0.9962</upward>
      <link_name>base_link</link_name>
      <control_joint_name>right_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-0.75</control_joint_rad_to_cl>
    </plugin>

    <!-- left v-tail -->
    <plugin filename="AltitudeLiftDrag"
        name="talon_sim::AltitudeLiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.33 0.08 0.051</cp>
      <area>0.025</area>
      <forward>1 0 0</forward>
      <!-- RUDDER SIGN.  Was <upward>0 1 1</upward>, which describes an
           INVERTED V: for an upright V the left panel's normal tilts INBOARD,
           and this link's own pose has roll +45 deg, i.e. tip up and outboard.
           The link geometry and the aerodynamics disagreed.

           Measured consequence: a POSITIVE rudder command produced a NEGATIVE
           yaw rate. ArduPlane assumes the opposite, so its yaw rate controller
           drove the wrong way and pinned the rudder at full travel - a +30%
           step gave -65 deg/s. A law that commands deflection never noticed,
           because the sign was measured from flight and built in by hand.

           Flipping both normals inverts the RUDDER and leaves the weathercock
           stability untouched: 4 deg of sideslip gives the same +0.257 either
           way, while the rudder's share goes -0.283 -> +0.283. That asymmetry
           is what identifies it as a sign error rather than a tuning one.

           Upstream mini_talon_vtail carries the same values. Inherited. -->
      <upward>0 -1 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>left_ruddervator_joint</control_joint_name>
      <control_joint_rad_to_cl>-2.0</control_joint_rad_to_cl>
    </plugin>

    <!-- right v-tail -->
    <plugin filename="AltitudeLiftDrag"
        name="talon_sim::AltitudeLiftDrag">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.33 -0.08 0.051</cp>
      <area>0.025</area>
      <forward>1 0 0</forward>
      <!-- RUDDER SIGN.  Was <upward>0 -1 1</upward>, which describes an
           INVERTED V: for an upright V the left panel's normal tilts INBOARD,
           and this link's own pose has roll -45 deg, i.e. tip up and outboard.
           The link geometry and the aerodynamics disagreed.

           Measured consequence: a POSITIVE rudder command produced a NEGATIVE
           yaw rate. ArduPlane assumes the opposite, so its yaw rate controller
           drove the wrong way and pinned the rudder at full travel - a +30%
           step gave -65 deg/s. A law that commands deflection never noticed,
           because the sign was measured from flight and built in by hand.

           Flipping both normals inverts the RUDDER and leaves the weathercock
           stability untouched: 4 deg of sideslip gives the same +0.257 either
           way, while the rudder's share goes -0.283 -> +0.283. That asymmetry
           is what identifies it as a sign error rather than a tuning one.

           Upstream mini_talon_vtail carries the same values. Inherited. -->
      <upward>0 1 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>right_ruddervator_joint</control_joint_name>
      <control_joint_rad_to_cl>-2.0</control_joint_rad_to_cl>
    </plugin>


    <!-- ================================================================ -->
    <!-- VISION TURRET  (ported from zephyr, frame-corrected for Talon)   -->
    <!--                                                                  -->
    <!-- Talon forward = +X, so turret links are UNROTATED: a Gazebo      -->
    <!-- camera looks along its link +X, which is the nose direction.     -->
    <!-- Zephyr needed yaw -1.5707 because its forward was -Y.            -->
    <!--                                                                  -->
    <!-- Mount: 0.3 m forward of CG, 0.08 m below centreline.          -->
    <!-- ================================================================ -->

    <!-- Fixed forward camera (HUD / chase view) -->
    <link name="chase_cam_link">
      <pose>0.3 0.0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="chase_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>8</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>1000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="chase_cam_joint" type="fixed">
      <parent>base_link</parent>
      <child>chase_cam_link</child>
    </joint>

    <!-- 2-axis gimbal: base (fixed) -> pan (yaw/Z) -> tilt (pitch/Y) -->
    <link name="gimbal_base_link">
      <pose>0.3 0.0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="gimbal_base_joint" type="fixed">
      <parent>base_link</parent>
      <child>gimbal_base_link</child>
    </joint>

    <!-- Pan link: rotates left/right about model Z -->
    <link name="gimbal_pan_link">
      <pose>0.3 0.0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="gimbal_pan_joint" type="revolute">
      <parent>gimbal_base_link</parent>
      <child>gimbal_pan_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.5708</lower>  <!-- -90 deg -->
          <upper>1.5708</upper>   <!--  90 deg -->
          <effort>10</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Tilt / camera link: rotates up/down about model Y.
         NOTE: Zephyr used model X here. The Talon's lateral axis is Y,
         so this axis is changed. Getting this wrong tilts the camera
         in roll instead of pitch, with no error message. -->
    <link name="gimbal_cam_link">
      <pose>0.3 0.0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="gimbal_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>1000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="gimbal_tilt_joint" type="revolute">
      <parent>gimbal_pan_link</parent>
      <child>gimbal_cam_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>  <!-- -90 deg -->
          <upper>1.5708</upper>   <!--  90 deg -->
          <effort>10</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Joint position controllers: gains copied from the Zephyr turret -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_pan_joint</joint_name>
      <topic>/gimbal/pan/cmd_pos</topic>
      <p_gain>5.0</p_gain>
      <i_gain>0.01</i_gain>
      <d_gain>0.2</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_tilt_joint</joint_name>
      <topic>/gimbal/tilt/cmd_pos</topic>
      <p_gain>5.0</p_gain>
      <i_gain>0.01</i_gain>
      <d_gain>0.2</d_gain>
    </plugin>

    <!-- fuselage: side force due to sideslip (Y_beta) ======================
         WHY THIS BLOCK EXISTS.

         Without it the ONLY lateral aero force on the aircraft is the v-tail,
         and the v-tail's sideslip force and its rudder force act at the SAME
         station, cp x = -0.33.  The yaw moment is therefore N = -0.33 * Y_tot,
         so steady flight (N = 0) forces Y_tot = 0 EXACTLY.  The aircraft yaws,
         holds sideslip, and never turns.  Measured with the rudder saturated
         at 49.9% of surface: 9.17 deg of sideslip, 0.000 deg/s of course
         change, over 20 s.  It is algebra, not aerodynamics - no deflection of
         any size can turn the aircraft while every lateral force shares one x.

         A real fuselage carries 30-50% of the side force while contributing
         almost nothing to the yaw moment, because it acts near the CG.  That
         asymmetry is the entire mechanism of a skidding turn.

         <upward>0 1 0</upward> is the point: horizontal, so this element's
         "lift" acts sideways.  <cp>0 0 0</cp> is the CG (base_link's inertial
         pose is 0 0 0), so it adds Y_beta and NO yaw moment - the weathercock
         stiffness already calibrated here is untouched.

         area 0.07 m2 is the side projection of an 860 mm airframe: pod about
         0.45 x 0.13 m plus boom about 0.35 x 0.05 m.  With cla 1.5 that is
         C_Ybeta = -0.33/rad for the body, -0.62 total, inside the -0.3..-0.6
         textbook band for a small aeroplane.  Measure the side area off
         mini_talon_fuselage_collision.stl to replace the estimate.

         cd = |cda * alpha| in this plugin, so this adds no drag at zero
         sideslip and nothing changes in coordinated flight.
    -->
    <plugin filename="AltitudeLiftDrag"
        name="talon_sim::AltitudeLiftDrag">
      <a0>0</a0>
      <cla>1.5</cla>
      <cda>0.15</cda>
      <cma>0</cma>
      <alpha_stall>0.6</alpha_stall>
      <cla_stall>-0.5</cla_stall>
      <cda_stall>0.6</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>0 0 0</cp>
      <area>0.07</area>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <link_name>base_link</link_name>
    </plugin>

    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!-- Port settings. -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>

      <!-- Frame transforms.-->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 1.57079632</gazeboXYZToNED>

      <!-- Sensors. -->
      <imuName>base_link::imu_sensor</imuName>

      <!--
          Joint range -30/+30 deg

          SERVO1_FUNCTION   4 (Aileron)
          SERVO1_MAX        2000
          SERVO1_MIN        1000
          SERVO1_REVERSED   0
          SERVO1_TRIM       1500
       -->
      <control channel="0">
        <jointName>left_aileron_joint</jointName>
        <multiplier>-1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/left_aileron_joint/cmd_pos</cmd_topic>
      </control>

      <control channel="0">
        <jointName>right_aileron_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/right_aileron_joint/cmd_pos</cmd_topic>
      </control>

      <!--
          Joint range -30/+30 deg

          SERVO2_FUNCTION   79 (Left V-Tail)
          SERVO2_MAX        2000
          SERVO2_MIN        1000
          SERVO2_REVERSED   0
          SERVO2_TRIM       1500
       -->
      <control channel="1">
        <jointName>left_ruddervator_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/left_ruddervator_joint/cmd_pos</cmd_topic>
      </control>

      <!--
          SERVO3_FUNCTION   70 (Throttle)
          SERVO3_MAX        2000
          SERVO3_MIN        1000
          SERVO3_REVERSED   0
          SERVO3_TRIM       1000
       -->
      <control channel="2"> 
        <jointName>motor_joint</jointName>
        <multiplier>1000</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <!-- <type>COMMAND</type>
        <cmd_topic>/model/mini_talon_vtail/joint/motor_joint/cmd_vel</cmd_topic> -->

        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>1</i_max>
        <i_min>-1</i_min>
        <cmd_max>5.0</cmd_max>
        <cmd_min>-5.0</cmd_min>
      </control>

      <!--
          Joint range -30/+30 deg

          SERVO4_FUNCTION   80 (Right V-Tail)
          SERVO4_MAX        2000
          SERVO4_MIN        1000
          SERVO4_REVERSED   0
          SERVO4_TRIM       1500
       -->
      <control channel="3">
        <jointName>right_ruddervator_joint</jointName>
        <multiplier>1.0471976</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/right_ruddervator_joint/cmd_pos</cmd_topic>
      </control>

    </plugin>

  </model>
</sdf>

<!-- 
  Motor thrust calcs (initial estimates)

  PropDrive 3536 910kV motor
  3S battery (11.1V)
  rpm_max = 10000
  rpm = 8000
  ang_max = 1057
  ang_vel = 837
  10x7 prop

  Inertials

  fuselage:
  mass: 
  radius: 0.16 m
  length: 0.8 m

  main wheel:
  mass: 
  radius: 0.0135 m
  length: 0.014 m

  L/R wing
  mass: 
  area: 0.65 x 0.245 = 0.16 m^2
  cp: 

  L/R aileron
  mass:
  area: 0.237 x 0.0477 = 0.011 m^2
  cp: 

  L/R v-tail
  mass: 
  area: 0.126 x 0.197 = 0.025 m^2
  cp: 

  L/R ruddervator
  mass: 
  area: 0.042 x 0.154 = 0.0065 m^2
  cp: 

  Position and thrust controller commands

  Thrust:

  gz topic -t /model/mini_talon_vtail/joint/motor_joint/cmd_vel -m gz.msgs.Double -p 'data: 1000'

  Aileron:

  gz topic -t /right_aileron_joint/cmd_pos -m gz.msgs.Double -p 'data: 1'

  Ruddervator:

  gz topic -t /left_ruddervator_joint/cmd_pos -m gz.msgs.Double -p 'data: 1'

  -->

